	\"Wheel Up\": preload(\"res://UI screens/menu's/visuals/button_controll/button_mouse_middle_up.png\"),
	\"Wheel Down\": preload(\"res://UI screens/menu's/visuals/button_controll/button_mouse_middle_down.png\"),
	\"Joy A\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0021_A.png\"),        # Switch A / Xbox A / PS Cross
	\"Joy B\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0020_B.png\"),        # Switch B / Xbox B / PS Circle
	\"Joy X\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0023_X.png\"),        # Switch X / Xbox X / PS Square
	\"Joy Y\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0022_Y.png\"),        # Switch Y / Xbox Y / PS Triangle
	\"Joy L\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0019_xbone_LB.png\"),        # Switch L / Xbox LB / PS L1
	\"Joy R\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0018_xbone_RB.png\"),        # Switch R / Xbox RB / PS R1
	\"Joy ZL\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0017_xbone_LT.png\"),       # Switch ZL / Xbox LT / PS L2
	\"Joy ZR\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0016_xbone_RT.png\"),       # Switch ZR / Xbox RT / PS R2
	\"Joy -\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0015_xbone_view.png\"),        # Switch - / Xbox View (2 Cubes) / PS Share
	\"Joy +\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0014_xbone_menu.png\"),        # Switch + / Xbox Menu (3 Lines) / PS Options
	\"Joy D-Pad Up\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0006_xbox360_up.png\"),
	\"Joy D-Pad Down\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0006_xbox360_down.png\"),
	\"Joy D-Pad Left\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0006_xbox360_l.png\"),
	\"Joy D-Pad Right\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0006_xbox360_r.png\"),
	\"Joy Touchpad\": preload(\"res://UI screens/menu's/visuals/button_controll/controller_button_skins_0001_ps4_touchpad_press.png\"), # PS4/5 Touchpad
}


# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1

# the found texture rect
var rect_node: TextureRect = null

# the final hbox found
var target_hbox: HBoxContainer = null
# current amount of hboxes found
var hbox_count = 0 
# the final number of hboxes in the index that is the one you search for
var hbox_target_index = 1


# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current
	
	# if the found is an HBOX
	if current is HBoxContainer:
		#increase HBOX count
		hbox_count += 1
		# if you found the target number of hboxes
		if hbox_count == hbox_target_index:
			# THIS IS THE GOOD hbox
			target_hbox = current

	# if you found an textureRect
	elif current is TextureRect:
		# this node is the texture rect
		rect_node = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())

# change the label you found
if target_label:
	target_label.text = \"Press New Key\"

# also change the textureRect you found
if rect_node:
	rect_node.texture = null

# change the hbox seperation
if target_hbox:
	target_hbox.add_theme_constant_override(&\"separation\", config.row_spacing - 100)



# first wait a small time
await me.get_tree().create_timer(0.1).timeout

# create a overlay that makes the other buttons not pressable
var overlay = Control.new()
me.get_tree().root.add_child(overlay)
overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
overlay.mouse_filter = Control.MOUSE_FILTER_STOP

# have the overlay get keyboard buttons
overlay.focus_mode = Control.FOCUS_ALL 
overlay.grab_focus()

# the var that should get the event
var final_event: InputEvent = null

# the name that the key has (readable version)
var key_name

while final_event == null:
	await me.get_tree().process_frame
	final_event = await overlay.gui_input 
	
	if final_event is InputEventKey and final_event.is_pressed():
		key_name = OS.get_keycode_string(final_event.get_keycode_with_modifiers())
		me.get_viewport().set_input_as_handled()
	
	elif final_event is InputEventMouseButton and final_event.is_pressed():
		# Use explicit integers to ensure \"Wheel Up/Down\" are caught correctly
		var idx = final_event.button_index
		if idx == MOUSE_BUTTON_LEFT: key_name = \"Left Mouse Button\"
		elif idx == MOUSE_BUTTON_RIGHT: key_name = \"Right Mouse Button\"
		elif idx == MOUSE_BUTTON_MIDDLE: key_name = \"Middle Mouse Button\"
		elif idx == MOUSE_BUTTON_WHEEL_UP: key_name = \"Wheel Up\"
		elif idx == MOUSE_BUTTON_WHEEL_DOWN: key_name = \"Wheel Down\"
		else: key_name = \"Mouse \" + str(idx)
		me.get_viewport().set_input_as_handled()
	
	elif final_event is InputEventJoypadButton and final_event.is_pressed():
		match final_event.button_index:
			JOY_BUTTON_A: key_name = \"Joy A\"
			JOY_BUTTON_B: key_name = \"Joy B\"
			JOY_BUTTON_X: key_name = \"Joy X\"
			JOY_BUTTON_Y: key_name = \"Joy Y\"
			JOY_BUTTON_LEFT_SHOULDER: key_name = \"LB\"
			JOY_BUTTON_RIGHT_SHOULDER: key_name = \"RB\"
			JOY_BUTTON_BACK: key_name = \"Joy -\"
			JOY_BUTTON_START: key_name = \"Joy +\"
			JOY_BUTTON_DPAD_UP: key_name = \"Joy D-Pad Up\"
			JOY_BUTTON_DPAD_DOWN: key_name = \"Joy D-Pad Down\"
			JOY_BUTTON_DPAD_LEFT: key_name = \"Joy D-Pad Left\"
			JOY_BUTTON_DPAD_RIGHT: key_name = \"Joy D-Pad Right\"
			JOY_BUTTON_TOUCHPAD: key_name = \"Joy Touchpad\"
			# Standard mappings for triggers if handled as buttons
			17: key_name = \"Joy ZL\" 
			18: key_name = \"Joy ZR\"
			_: key_name = \"Controller \" + str(final_event.button_index)
		me.get_viewport().set_input_as_handled()
	else:
		final_event = null

# remove the overlay
overlay.queue_free()

# if you have a label and texture rect
if target_label and rect_node:
	# if the key to visual has this button 
	if visual_map.has(key_name):
		# if it does hide text and show that icon
		target_label.text = \"\"
		rect_node.texture = visual_map[key_name]
	else:
		# if not use the key name and the empty visual
		target_label.text = \"  \" + key_name + \"  \"
		# use a bigger texture if it is an bigger word
		rect_node.texture = empty_visual if key_name.length() <= 4 else empty_visual_big

# change the hbox seperation
if target_hbox:
	target_hbox.add_theme_constant_override(&\"separation\", config.row_spacing)

# release input lock
if holder and \"is_input_locked\" in holder:
	holder.is_input_locked = false


# get the value to save
var value_to_save: int = 0

if final_event is InputEventMouseButton:
	# Store Mouse as 1-99
	value_to_save = final_event.button_index 
elif final_event is InputEventJoypadButton:
	# Store Controller as 100-999 (Index + 100)
	value_to_save = final_event.button_index + 100
elif final_event is InputEventKey:
	# Store Keyboard as 1000+ (Keycode + 1000)
	value_to_save = final_event.keycode + 1000

SaveLoad.general_contents[\"Buttons\"][input] = value_to_save"
