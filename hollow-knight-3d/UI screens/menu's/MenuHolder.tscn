ready_function = "# the input this searches for
var input: StringName = &\"MoveRight\"
var input_name: StringName = \"Right\"
var key_name: String
var events


# wait
await ctx[0].get_tree().process_frame
await ctx[0].get_tree().create_timer(1).timeout
await ctx[0].get_tree().process_frame

# get if there are input key(s)
if not InputMap.has_action(input):
	return

# get  input key(s)
events = InputMap.action_get_events(input)

# if there are no input keys return
if events.is_empty():
	return

# get the event that is connected
var final_event = events[0]

# KEYBOARD
if final_event is InputEventKey:
	key_name = OS.get_keycode_string(final_event.keycode)
	if key_name.is_empty():
		key_name = OS.get_keycode_string(final_event.physical_keycode)

# MOUSE
elif final_event is InputEventMouseButton:
	match final_event.button_index:
		MOUSE_BUTTON_LEFT: key_name = \"Left Mouse Button\"
		MOUSE_BUTTON_RIGHT: key_name = \"Right Mouse Button\"
		MOUSE_BUTTON_MIDDLE: key_name = \"Middle Mouse Button\"
		MOUSE_BUTTON_WHEEL_UP: key_name = \"Wheel Up\"
		MOUSE_BUTTON_WHEEL_DOWN: key_name = \"Wheel Down\"
		_: key_name = \"Mouse \" + str(final_event.button_index)

# CONTROLLER
elif final_event is InputEventJoypadButton:
	match final_event.button_index:
		JOY_BUTTON_A: key_name = \"Joy A\"
		JOY_BUTTON_B: key_name = \"Joy B\"
		JOY_BUTTON_X: key_name = \"Joy X\"
		JOY_BUTTON_Y: key_name = \"Joy Y\"
		JOY_BUTTON_LEFT_SHOULDER: key_name = \"LB\"
		JOY_BUTTON_RIGHT_SHOULDER: key_name = \"RB\"
		JOY_BUTTON_BACK: key_name = \"Joy -\"
		JOY_BUTTON_START: key_name = \"Joy +\"
		JOY_BUTTON_DPAD_UP: key_name = \"Joy D-Pad Up\"
		JOY_BUTTON_DPAD_DOWN: key_name = \"Joy D-Pad Down\"
		JOY_BUTTON_DPAD_LEFT: key_name = \"Joy D-Pad Left\"
		JOY_BUTTON_DPAD_RIGHT: key_name = \"Joy D-Pad Right\"
		JOY_BUTTON_TOUCHPAD: key_name = \"Joy Touchpad\"
		17: key_name = \"Joy ZL\"
		18: key_name = \"Joy ZR\"
		_: key_name = \"Joy Button \" + str(final_event.button_index)



# get this node
var me = ctx[2]
var config = ctx[1]
# set this node as the initial node you should check
var nodes_to_check = [me]

# the visual for non texture buttons
var empty_visual = preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_key.png\")
var empty_visual_big = preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0003_wide_square_key.png\")


# visuals for each key
var visual_map = {
	\"Up\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow_u.png\"),
	\"Down\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow_d.png\"),
	\"Left\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow.png\"),
