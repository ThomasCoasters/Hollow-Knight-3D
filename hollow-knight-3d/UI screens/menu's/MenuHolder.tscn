script = ExtResource("2_w13no")
mode = 5
_text_group_enabled = false
hover_offset = Array[Vector2]([Vector2(-100, -4), Vector2(140, -4)])
ready_function = "
# wait
await ctx[0].get_tree().process_frame
await ctx[0].get_tree().create_timer(1).timeout
await ctx[0].get_tree().process_frame






# get this node
var me = ctx[2]
# set this node as the initial node you should check
var nodes_to_check = [me]

# get the startscreen
var root = ctx[0].get_tree().root
var screen = root.get_node_or_null(\"startscreen\")



# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1



# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())





# set the input name
if target_label:
	target_label.custom_minimum_size.x = 300
	target_label.text = screen.get_bg_visual()"
pressed_function = "# get array of the bgs
var bg_names =[\"Classic\", \"Lifeblood\", \"Grimm\", \"Godmaster\"]


# get this node
var me = ctx[2]

# get the startscreen
var root = ctx[0].get_tree().root
var screen = root.get_node_or_null(\"startscreen\")

# set this node as the initial node you should check
var nodes_to_check = [me]

# get the next bg index
var next_bg_index = (bg_names.find(screen.get_bg_visual()) + 1) % bg_names.size()


# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1



# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())




# get the next bg's name
var next_bg_name = bg_names[next_bg_index]

# set the startscreen to the new bg
screen.set_bg_visual(next_bg_name)

# set the saved setting to the new one
SaveLoad.general_contents[&\"Extras\"][&\"Background\"] = next_bg_name


# set the input name
if target_label:
	target_label.text = next_bg_name




# load the values
SaveLoad._load_video()"
