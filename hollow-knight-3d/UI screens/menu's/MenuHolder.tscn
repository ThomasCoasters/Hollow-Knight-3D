script = ExtResource("2_w13no")
in_start_delay = 0.17
out_start_delay = 0.17
text = "Yes"
pressed_function = "# get this node
var me = ctx[2]

# dissable all the buttons
ctx[0].toggle_buttons(false)

# track what signal is completed
var state := {
	\"save_done\": false,
	\"transition_done\": false
}

# create listeners for when the signals are finished
SaveLoad.save_exited.connect(func(_path):
	state.save_done = true
, CONNECT_ONE_SHOT)

transition.on_transition_finished.connect(func():
	state.transition_done = true
, CONNECT_ONE_SHOT)


# save the general settings
SaveLoad.save_general()

# play the transition
transition.play_transition(false, true)


# wait until both signals are done
while not state.save_done or not state.transition_done:
	await me.get_tree().process_frame

# wait a small extra amount to let the save animation finish
await me.get_tree().create_timer(0.7).timeout


# quit the game using the Menu
ctx[0].get_tree().quit()"
