[sub_resource type="Resource" id="Resource_gg8iy"]
script = ExtResource("2_w13no")
mode = 5
_text_group_enabled = false
ready_function = "var save_number: int = 1

if SaveLoad.save_slot_exists(save_number):
	SceneLoader.request_scene(SaveLoad.get_slot_value(save_number, [&\"Location\", &\"current_map\"]))

# texture per area name
var area_visual = {
	&\"KingsPass\": preload(\"uid://d4c4jrywlxaw5\")
}


await ctx[0].get_tree().process_frame
await ctx[0].get_tree().create_timer(1).timeout
await ctx[0].get_tree().process_frame

# get meeeeeeeeeeeee
var me = ctx[2]

# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1


# the final label found
var target_tex: TextureRect = null
# current amount of labels found
var tex_count = 0 
# the final number of label in the index that is the one you search for
var tex_target_index = 1

var nodes_to_check = [me]


# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current

	if current is TextureRect:
		tex_count += 1
		if tex_count == tex_target_index:
			target_tex = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())



if target_label:
	target_label.z_index = 1
	if SaveLoad.save_slot_exists(save_number):
		target_label.text = str(save_number) + \".\"
		if target_tex: target_tex.visible = true
	else:
		target_label.text = \"                                               Create New\"
		if target_tex: target_tex.visible = false

if target_tex:
	var area = SaveLoad.get_slot_value(1, [&\"Location\", &\"Area\"])
	if area == null:
		area = SaveLoad.DEFAULT_GAME_SAVE[&\"Location\"][&\"Area\"]
	
	target_tex.texture = area_visual[area]
	
		
"
pressed_function = "# the save slot of this node
var save_number: int = 1

# get meeeeeeeeeeeee
var me = ctx[2]


# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1


# the final label found
var target_tex: TextureRect = null
# current amount of labels found
var tex_count = 0 
# the final number of label in the index that is the one you search for
var tex_target_index = 1

var nodes_to_check = [me]


# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current

	if current is TextureRect:
		tex_count += 1
		if tex_count == tex_target_index:
			target_tex = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())


if target_label:
	if target_label.text == str(save_number) + \".\":
		# set the current save slot
		SaveLoad.current_slot = save_number
		
		# get a refrence of if the save is done and the transition is done
		var state := {
			\"load_done\": false,
			\"transition_done\": false
		}
		
		# create listeners for when the signals are finished
		SaveLoad.load_exited.connect(func(_path):
			state.load_done = true
		, CONNECT_ONE_SHOT)
		transition.on_transition_finished.connect(func():
			state.transition_done = true
		, CONNECT_ONE_SHOT)


		# load the save slot
		SaveLoad.load_game_slot(save_number)
		
		# play the transition
		transition.play_transition(false, true)


		# wait until both signals are done
		while not state.load_done or not state.transition_done:
			await me.get_tree().process_frame


		me.get_tree().change_scene_to_packed(SceneLoader.force_get_scene(\"res://Game/main_scene/map_holder.tscn\"))

		transition.play_transition(false, false)

		return


	target_label.text = str(save_number) + \".\"
	if target_tex: target_tex.visible = true
"
_row_group_enabled = true
sub_configs = Array[ExtResource("2_w13no")]([SubResource("Resource_mf0eo"), SubResource("Resource_c2gy6"), SubResource("Resource_pm3mi")])
row_spacing = 0
metadata/_custom_type_script = "uid://54ijfc61lomj"

[sub_resource type="Resource" id="Resource_qnj6i"]
script = ExtResource("2_w13no")
text = "Clear Save"
ready_function = "# get meeeeeeeeeeeee
var me = ctx[2]

me.custom_minimum_size.x = 300"
pressed_function = "# the save slot of this node
var save_number: int = 1

# get meeeeeeeeeeeee
var me = ctx[2]

if me.text == \"Clear Save\":
	me.text = \"Are You Sure?\"
	return
else:
	me.text = \"Clear Save\"
	SaveLoad.delete_save_slot(save_number)




# the final label found
var target_label: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_target_index = 1

# the final label found
var target_tex: TextureRect = null
# current amount of labels found
var tex_count = 0 
# the final number of label in the index that is the one you search for
var tex_target_index = 1

var nodes_to_check = [me.get_parent()]



# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_target_index:
			# THIS IS THE GOOD LABEL
			target_label = current

	if current is TextureRect:
		tex_count += 1
		if tex_count == tex_target_index:
			target_tex = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())


if target_label:
	if SaveLoad.save_slot_exists(save_number):
		target_label.text = str(save_number) + \".\"
		if target_tex: target_tex.visible = true
	else:
		target_label.text = \"                                               Create New\"
		if target_tex: target_tex.visible = false
		return"
should_add_vertical_spacer = false
metadata/_custom_type_script = "uid://54ijfc61lomj"

