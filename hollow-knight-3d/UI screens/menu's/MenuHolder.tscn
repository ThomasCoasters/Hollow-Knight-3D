ready_function = "# the input this searches for
var input: StringName = &\"MoveLeft\"
var input_name: StringName = \"Left\"
var key_name: String
var events


# wait
await ctx[0].get_tree().process_frame
await ctx[0].get_tree().create_timer(1).timeout
await ctx[0].get_tree().process_frame

# get if there are input key(s)
if not InputMap.has_action(input):
	return

# get  input key(s)
events = InputMap.action_get_events(input)

# if there are no input keys return
if events.is_empty():
	return

# get the event that is connected
var final_event = events[0]

# keyboard
if final_event is InputEventKey:
	# get the keycode string
	key_name = OS.get_keycode_string(final_event.keycode)

	if key_name.is_empty():
		# if that does not work get the PHYSICAL keycode string
		key_name = OS.get_keycode_string(final_event.physical_keycode)

# mouse
elif final_event is InputEventMouseButton:
	# set a readable name
	if final_event.button_index == MOUSE_BUTTON_LEFT: key_name = \"Left Mouse Button\"
	elif final_event.button_index == MOUSE_BUTTON_RIGHT: key_name = \"Right Mouse Button\"
	elif final_event.button_index == MOUSE_BUTTON_MIDDLE: key_name = \"Middle Mouse Button\"
	else: key_name = \"Mouse \" + str(final_event.button_index)



# get this node
var me = ctx[2]
var config = ctx[1]
# set this node as the initial node you should check
var nodes_to_check = [me]

# the visual for non texture buttons
var empty_visual = preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_key.png\")
var empty_visual_big = preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0003_wide_square_key.png\")


# visuals for each key
var visual_map = {
	\"Up\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow_u.png\"),
	\"Down\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow_d.png\"),
	\"Left\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow.png\"),
	\"Right\": preload(\"res://UI screens/menu's/visuals/button_controll/button_skin_0004_square_arrow_r.png\"),
	\"Left Mouse Button\": preload(\"res://UI screens/menu's/visuals/button_controll/button_mouse_left_click.png\"),
	\"Middle Mouse Button\": preload(\"res://UI screens/menu's/visuals/button_controll/button_mouse_middle_click.png\"),
	\"Right Mouse Button\": preload(\"res://UI screens/menu's/visuals/button_controll/button_mouse_right_click.png\")
}






# the final label found
var target_label_1: Label = null
var target_label_2: Label = null
# current amount of labels found
var label_count = 0 
# the final number of label in the index that is the one you search for
var label_1_target_index = 1
var label_2_target_index = 2

# the found texture rect
var rect_node: TextureRect = null

# the final hbox found
var target_hbox: HBoxContainer = null
# current amount of hboxes found
var hbox_count = 0 
# the final number of hboxes in the index that is the one you search for
var hbox_target_index = 1


# keep searching untill all children are gone through
while nodes_to_check.size() > 0:
	#remove the current node from the nodes you should check
	var current = nodes_to_check.pop_back()
	
	# if you found an label
	if current is Label:
		#increase label count
		label_count += 1
		# if you found the target number of labels
		if label_count == label_1_target_index:
			# THIS IS THE GOOD LABEL
			target_label_1 = current
		# if you found the target number of labels: 2 electric boogaloo
		if label_count == label_2_target_index:
			# THIS IS THE GOOD LABEL
			target_label_2 = current
	
	# if the found is an HBOX
	if current is HBoxContainer:
		#increase HBOX count
		hbox_count += 1
		# if you found the target number of hboxes
		if hbox_count == hbox_target_index:
			# THIS IS THE GOOD hbox
			target_hbox = current

	# if you found an textureRect
	elif current is TextureRect:
		# this node is the texture rect
		rect_node = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())




#print(\"KEY NAME: \", key_name)
#print(\"LABEL FOUND: \", target_label_1)
#print(\"RECT FOUND: \", rect_node)

# if you have a label and texture rect
if target_label_1 and rect_node:
	# if the key to visual has this button 
	if visual_map.has(key_name):
		# if it does hide text and show that icon
		target_label_1.text = \"\"
		rect_node.texture = visual_map[key_name]
	else:
		# if not use the key name and the empty visual
		target_label_1.text = \"  \" + key_name + \"  \"
		# use a bigger texture if it is an bigger word
		rect_node.texture = empty_visual if key_name.length() <= 4 else empty_visual_big

# set the input name
if target_label_2:
	target_label_2.text = input_name

# change the hbox seperation
if target_hbox:
	target_hbox.add_theme_constant_override(&\"separation\", config.row_spacing)"
