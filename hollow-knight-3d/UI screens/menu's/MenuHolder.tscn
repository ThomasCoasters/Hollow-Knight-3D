		# if you found the target number of labels: 2 electric boogaloo
		if label_count == label_2_target_index:
			# THIS IS THE GOOD LABEL
			target_label_2 = current
	
	# if the found is an HBOX
	if current is HBoxContainer:
		#increase HBOX count
		hbox_count += 1
		# if you found the target number of hboxes
		if hbox_count == hbox_target_index:
			# THIS IS THE GOOD hbox
			target_hbox = current

	# if you found an textureRect
	elif current is TextureRect:
		# this node is the texture rect
		rect_node = current
	
	# also search all these node's children
	nodes_to_check.append_array(current.get_children())




